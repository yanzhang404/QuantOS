[Unit]
Description=QuantOS daily intelligence refresh
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/QuantOS
ExecStart=/usr/bin/docker compose --profile research-admin run --rm intelligence-refresh
TimeoutStartSec=10min

# The container has public read-only network access and no exchange credentials.
NoNewPrivileges=true
