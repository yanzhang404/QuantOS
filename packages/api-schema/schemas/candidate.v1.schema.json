{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantos.local/schemas/candidate.v1.schema.json",
  "title": "QuantOS Candidate Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_slug",
    "title",
    "hypothesis",
    "rationale",
    "category",
    "supported_intervals",
    "parameters",
    "implementation_plan",
    "research_plan",
    "sources",
    "proposed_by"
  ],
  "properties": {
    "schema_version": { "const": "candidate-proposal.v1" },
    "strategy_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$" },
    "title": { "type": "string", "minLength": 4, "maxLength": 120 },
    "hypothesis": { "type": "string", "minLength": 20, "maxLength": 500 },
    "rationale": { "type": "string", "minLength": 20, "maxLength": 1000 },
    "category": { "enum": ["trend", "mean_reversion", "intraday"] },
    "supported_intervals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["5m", "15m", "1h", "4h", "1d"] }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "kind", "label", "default", "minimum", "maximum"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
          "kind": { "enum": ["integer", "decimal"] },
          "label": { "type": "string", "minLength": 2, "maxLength": 80 },
          "default": { "type": ["integer", "string"] },
          "minimum": { "type": ["integer", "string"] },
          "maximum": { "type": ["integer", "string"] }
        }
      }
    },
    "implementation_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 8, "maxLength": 200 }
    },
    "research_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 8, "maxLength": 200 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 4, "maxLength": 200 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "proposed_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "workflow_version"],
      "properties": {
        "kind": { "const": "agent" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "workflow_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  }
}
