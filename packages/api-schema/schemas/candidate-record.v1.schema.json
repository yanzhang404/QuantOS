{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantos.local/schemas/candidate-record.v1.schema.json",
  "title": "QuantOS Candidate Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "created_at",
    "updated_at",
    "status",
    "proposal",
    "implementation",
    "robustness_review_id",
    "robustness_sha256",
    "transitions"
  ],
  "properties": {
    "schema_version": { "const": "candidate-record.v1" },
    "proposal_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": ["proposed", "implemented", "review_ready", "approved", "rejected"]
    },
    "proposal": { "$ref": "candidate.v1.schema.json" },
    "implementation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation_ref", "test_ids"],
          "properties": {
            "implementation_ref": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.]{7,159}$"
            },
            "test_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{3,159}$"
              }
            }
          }
        }
      ]
    },
    "robustness_review_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{16}$"
    },
    "robustness_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_status",
          "to_status",
          "actor_kind",
          "actor_name",
          "rationale",
          "occurred_at",
          "evidence_id"
        ],
        "properties": {
          "from_status": {
            "type": ["string", "null"],
            "enum": [null, "proposed", "implemented", "review_ready"]
          },
          "to_status": {
            "enum": ["proposed", "implemented", "review_ready", "approved", "rejected"]
          },
          "actor_kind": { "enum": ["agent", "system", "human"] },
          "actor_name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "rationale": { "type": "string", "minLength": 8, "maxLength": 500 },
          "occurred_at": { "type": "string", "format": "date-time" },
          "evidence_id": { "type": ["string", "null"], "maxLength": 160 }
        }
      }
    }
  }
}
