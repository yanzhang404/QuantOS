{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantos.local/schemas/candidate-draft.v1.schema.json",
  "title": "QuantOS Candidate Draft Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_id",
    "proposal_id",
    "strategy_slug",
    "iso_week",
    "slot",
    "weekly_limit",
    "created_at",
    "status",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "candidate-draft.v1" },
    "draft_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "proposal_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "strategy_slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$" },
    "iso_week": { "type": "string", "pattern": "^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$" },
    "slot": { "type": "integer", "minimum": 1, "maximum": 2 },
    "weekly_limit": { "type": "integer", "minimum": 1, "maximum": 2 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "const": "prepared" },
    "artifacts": {
      "type": "array",
      "const": ["proposal.json", "review-checklist.json", "PULL_REQUEST.md"]
    }
  }
}
