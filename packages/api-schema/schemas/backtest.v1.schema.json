{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantos.local/schemas/backtest.v1.schema.json",
  "title": "QuantOS Backtest API v1",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/backtest_submission" },
    { "$ref": "#/$defs/backtest_task" },
    { "$ref": "#/$defs/experiment_record" },
    { "$ref": "#/$defs/experiment_visualization" },
    { "$ref": "#/$defs/strategy_catalog" }
  ],
  "$defs": {
    "dataset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "content_sha256", "symbol", "interval"],
      "properties": {
        "bundle_version": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9]{5,20}$"
        },
        "interval": {
          "enum": ["5m", "15m", "1h", "4h", "1d"]
        },
        "data_start": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "data_end": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "buy_and_hold_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parameters"],
      "properties": {
        "name": { "const": "buy-and-hold" },
        "version": { "const": "1.0.0" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_exposure"],
          "properties": {
            "target_exposure": {
              "type": "string",
              "pattern": "^(0\\.[0-9]*[1-9][0-9]*|1(\\.0+)?)$"
            }
          }
        }
      }
    },
    "ema_cross_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parameters"],
      "properties": {
        "name": { "const": "ema-cross" },
        "version": { "const": "1.0.0" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fast_period", "slow_period"],
          "properties": {
            "fast_period": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "slow_period": {
              "type": "integer",
              "minimum": 2,
              "maximum": 2000
            }
          }
        }
      }
    },
    "donchian_atr_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "parameters"],
      "properties": {
        "name": { "const": "donchian-atr" },
        "version": { "const": "1.0.0" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry_period",
            "exit_period",
            "atr_period",
            "target_annual_volatility",
            "max_exposure",
            "rebalance_threshold"
          ],
          "properties": {
            "entry_period": {
              "type": "integer",
              "minimum": 2,
              "maximum": 2000
            },
            "exit_period": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "atr_period": {
              "type": "integer",
              "minimum": 2,
              "maximum": 2000
            },
            "target_annual_volatility": {
              "type": "string",
              "pattern": "^(0\\.[0-9]*[1-9][0-9]*|1(\\.[0-9]+)?|2(\\.0+)?)$"
            },
            "max_exposure": {
              "type": "string",
              "pattern": "^(0\\.[0-9]*[1-9][0-9]*|1(\\.0+)?)$"
            },
            "rebalance_threshold": {
              "type": "string",
              "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
            }
          }
        }
      }
    },
    "strategy_ref": {
      "oneOf": [
        { "$ref": "#/$defs/buy_and_hold_strategy" },
        { "$ref": "#/$defs/ema_cross_strategy" },
        { "$ref": "#/$defs/donchian_atr_strategy" }
      ]
    },
    "backtest_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_cash",
        "fee_bps",
        "slippage_bps",
        "max_target_exposure",
        "liquidate_at_end"
      ],
      "properties": {
        "initial_cash": {
          "type": "string",
          "pattern": "^(0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(\\.[0-9]+)?)$"
        },
        "fee_bps": {
          "type": "string",
          "pattern": "^([0-9]{1,3}(\\.[0-9]+)?|1000(\\.0+)?)$"
        },
        "slippage_bps": {
          "type": "string",
          "pattern": "^([0-9]{1,3}(\\.[0-9]+)?|1000(\\.0+)?)$"
        },
        "max_target_exposure": {
          "type": "string",
          "pattern": "^(0\\.[0-9]*[1-9][0-9]*|1(\\.0+)?)$"
        },
        "liquidate_at_end": {
          "type": "boolean"
        }
      }
    },
    "backtest_submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "idempotency_key",
        "dataset",
        "strategy",
        "config"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "label": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 120
        },
        "note": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 500
        },
        "dataset": { "$ref": "#/$defs/dataset_ref" },
        "strategy": { "$ref": "#/$defs/strategy_ref" },
        "config": { "$ref": "#/$defs/backtest_config" }
      }
    },
    "task_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": { "type": "boolean" }
      }
    },
    "backtest_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "status",
        "created_at",
        "request",
        "run_id",
        "reused",
        "error"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "task_id": {
          "type": "string",
          "pattern": "^task_[0-9a-f]{16}$"
        },
        "status": {
          "enum": ["queued", "running", "succeeded", "failed", "cancelled"]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "finished_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "request": { "$ref": "#/$defs/backtest_submission" },
        "run_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{16}$"
        },
        "reused": { "type": ["boolean", "null"] },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/task_error" }
          ]
        }
      }
    },
    "experiment_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_equity",
        "final_equity",
        "total_return",
        "sharpe_ratio",
        "max_drawdown",
        "trade_count",
        "fill_count",
        "fees_paid"
      ],
      "properties": {
        "initial_equity": { "type": "number" },
        "final_equity": { "type": "number" },
        "total_return": { "type": "number" },
        "sharpe_ratio": { "type": ["number", "null"] },
        "max_drawdown": { "type": "number", "minimum": 0, "maximum": 1 },
        "trade_count": { "type": "integer", "minimum": 0 },
        "fill_count": { "type": "integer", "minimum": 0 },
        "fees_paid": { "type": "number", "minimum": 0 }
      }
    },
    "experiment_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "created_at",
        "request",
        "engine_version",
        "metrics_version",
        "metrics",
        "artifacts"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "created_at": { "type": "string", "format": "date-time" },
        "request": { "$ref": "#/$defs/backtest_submission" },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "metrics_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "metrics": { "$ref": "#/$defs/experiment_metrics" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "experiment_equity_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "equity", "drawdown", "position"],
      "properties": {
        "time": { "type": "string", "format": "date-time" },
        "equity": { "type": "number" },
        "drawdown": {
          "type": "number",
          "minimum": -1,
          "maximum": 0
        },
        "position": { "type": "number" }
      }
    },
    "experiment_fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "side", "price", "quantity", "fee", "reason"],
      "properties": {
        "time": { "type": "string", "format": "date-time" },
        "side": { "enum": ["buy", "sell"] },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "fee": { "type": "number", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "experiment_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "open", "high", "low", "close", "volume"],
      "properties": {
        "time": { "type": "string", "format": "date-time" },
        "open": { "type": "number", "exclusiveMinimum": 0 },
        "high": { "type": "number", "exclusiveMinimum": 0 },
        "low": { "type": "number", "exclusiveMinimum": 0 },
        "close": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "minimum": 0 }
      }
    },
    "experiment_visualization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "created_at",
        "dataset",
        "strategy",
        "config",
        "engine_version",
        "metrics_version",
        "metrics",
        "bars",
        "equity",
        "fills"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "created_at": { "type": "string", "format": "date-time" },
        "dataset": { "$ref": "#/$defs/dataset_ref" },
        "strategy": { "$ref": "#/$defs/strategy_ref" },
        "config": { "$ref": "#/$defs/backtest_config" },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "metrics_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "metrics": { "$ref": "#/$defs/experiment_metrics" },
        "bars": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/experiment_bar" }
        },
        "equity": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/experiment_equity_point" }
        },
        "fills": {
          "type": "array",
          "items": { "$ref": "#/$defs/experiment_fill" }
        }
      }
    },
    "parameter_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "label", "default", "minimum", "maximum"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "kind": { "enum": ["integer", "decimal"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "default": { "type": ["integer", "string"] },
        "minimum": { "type": ["integer", "string"] },
        "maximum": { "type": ["integer", "string"] }
      }
    },
    "strategy_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "label",
        "description",
        "category",
        "stage",
        "implementation",
        "supported_intervals",
        "parameters"
      ],
      "properties": {
        "name": {
          "enum": ["buy-and-hold", "ema-cross", "donchian-atr"]
        },
        "version": { "const": "1.0.0" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "category": {
          "enum": ["trend", "benchmark", "mean-reversion", "intraday"]
        },
        "stage": {
          "enum": ["candidate", "validated", "benchmark"]
        },
        "implementation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "supported_intervals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["5m", "15m", "1h", "4h", "1d"]
          }
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parameter_spec" }
        }
      }
    },
    "strategy_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "strategies"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "strategies": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/strategy_definition" }
        }
      }
    }
  }
}
